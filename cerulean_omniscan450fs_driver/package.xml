<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cerulean_omniscan450fs_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for the Cerulean Omniscan 450 FS forward-scan sonar</description>
  <maintainer email="farhang.naderi@uri.edu">Farhang Naderi</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-bluerobotics-ping-pip</depend>
  <depend>cerulean_omniscan450fs_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
